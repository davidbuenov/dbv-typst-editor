{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBV Typst Editor",
  "version": "0.1.0",
  "identifier": "com.davidbuenov.dbv-typst-editor",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DBV Typst Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/typst"
    ],
    "resources": [
      "../templates"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Editor Typst para escritura académica y técnica",
    "longDescription": "DBV Typst Editor es el entorno de escritorio más accesible para el ecosistema Typst: crea proyectos desde plantillas académicas, escribe y ve el PDF actualizarse en tiempo real, sin conexión.",
    "fileAssociations": [
      {
        "ext": [
          "typ"
        ],
        "name": "Documento Typst",
        "description": "Documento Typst de DBV Typst Editor",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyODQ1RUIyMEY0RkZBQzYKUldURytrOFBzbDZFOHNiV2RqL1JEQndJcEE4MU92ZGFoeGZzUmI3VDNrd3p5KzM0alFzK0krM0IK",
      "endpoints": [
        "https://github.com/davidbuenov/dbv-typst-editor/releases/latest/download/latest.json"
      ]
    }
  }
}
