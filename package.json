{
  "name": "dbv-typst-editor",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Editor de escritorio multiplataforma para documentos Typst, con vista previa PDF en tiempo real",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tauri build",
    "build:win:offline": "tauri build --config src-tauri/tauri.windows.offline.conf.json",
    "updater:manifest": "node scripts/updater-manifest.mjs",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "tauri": "tauri",
    "vendor:typst": "node scripts/vendor-typst.mjs",
    "verify:typst": "node scripts/verify-typst-sidecar.mjs",
    "verify:templates": "node scripts/verify-templates.mjs",
    "verify:frontend": "node scripts/verify-frontend.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "test:frontend": "vitest run",
    "test": "npm run test:frontend && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "icons": "node scripts/generate-base-icon.mjs && tauri icon src-tauri/icons/base.png",
    "tauri:windows:build": "tauri-windows-bundle build --runner npm"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-typst": "^0.6.0"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.29",
    "@tauri-apps/cli": "^2.9.0",
    "jsdom": "^29.1.1",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
