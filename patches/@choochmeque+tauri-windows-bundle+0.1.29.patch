+// PATCH: see call site above. Mirrors Tauri's own sidecar convention: an
+// `externalBin` entry names a base path (e.g. "binaries/typst") whose file on
+// disk carries the target-triple suffix ("binaries/typst-x86_64-pc-windows-msvc.exe"),
+// but the bundler DROPS that suffix when placing the binary in the app dir,
+// because `tauri-plugin-shell`'s sidecar() resolves at runtime to
+// `<dir of the running exe>/<base name>.exe` — no triple. Copying it under
+// the suffixed name would ship a binary the app can never find.
+function copyExternalBinSidecars(srcTauriDir, appxDir, tauriConfig, target) {
+    const externalBin = tauriConfig.bundle?.externalBin;
+    if (!externalBin || externalBin.length === 0)
+        return;
+    for (const base of externalBin) {
+        const baseName = path.basename(base);
+        const srcSidecar = path.join(srcTauriDir, path.dirname(base), `${baseName}-${target}.exe`);
+        if (!fs.existsSync(srcSidecar)) {
+            throw new Error(`Sidecar not found: ${srcSidecar} (declared in bundle.externalBin as "${base}")`);
+        }
+        fs.copyFileSync(srcSidecar, path.join(appxDir, `${baseName}.exe`));
+    }
