# Tauri / Rust build artifacts
target/
src-tauri/target/
# Esquemas de capabilities generados por tauri-build en cada compilación
src-tauri/gen/schemas/

# Sidecar oficial de Typst: se vendoriza en CI/local antes de `tauri build`
# (ARCHITECTURE.md §7.2), nunca se commitea el binario al repositorio.
src-tauri/binaries/

# Node dependencies & dist
node_modules/
dist/

# OS temporary files
.DS_Store
Thumbs.db
desktop.ini

# Environment / IDE settings
.env
.env.local
.vscode/
.idea/
.claude/*
!.claude/commands/

# Manifiesto de actualización generado por scripts/updater-manifest.mjs a partir
# del build firmado local: es un artefacto de release (se sube a la Release de
# GitHub), no fuente. Y cambia en cada versión.
latest.json

# Clave privada de firma del actualizador, por si alguna vez se deja caer aquí
# por error: NUNCA se versiona (ADR-ACTUALIZADOR-001).
*.key
